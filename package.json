{
  "name": "opencode2-cliproxyapi",
  "version": "0.2.1",
  "author": "İbrahim BABAL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moutansos/opencode2-cliproxyapi.git"
  },
  "main": "./dist/index.js",
  "devDependencies": {
    "@opencode/plugin": "2.0.4",
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "$schema": "https://json.schemastore.org/package.json",
  "bugs": {
    "url": "https://github.com/moutansos/opencode2-cliproxyapi/issues"
  },
  "contributors": [
    "Ben Brougher"
  ],
  "description": "Discover and use every model exposed by CLIProxyAPI in OpenCode V2.",
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/moutansos/opencode2-cliproxyapi#readme",
  "keywords": [
    "opencode",
    "opencode-v2",
    "cliproxyapi",
    "llm",
    "plugin"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target bun --format esm --external @opencode/plugin && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "check": "bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bun run check"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
